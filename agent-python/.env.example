# Pi Agent — 环境配置示例
# 复制此文件为 .env 并填写你的 API Key

# Kimi Code — Coding Plan（sk-kimi- 密钥，会员订阅）
# 文档: https://www.kimi.com/code/docs/en/
# KIMI_API_KEY=sk-kimi-...
# KIMI_API_BASE_URL=https://api.kimi.com/coding/v1
# PI_PROVIDER=kimi
# PI_MODEL=kimi-for-coding
# KIMI_USER_AGENT=KimiCLI/1.0

# Kimi Platform（按量计费，Moonshot 开放平台，非 Coding Plan）
# MOONSHOT_API_KEY=sk-...
# KIMI_API_BASE_URL=https://api.moonshot.ai/v1
# PI_MODEL=kimi-k2.6

# OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# PI_MAX_TURNS=50
